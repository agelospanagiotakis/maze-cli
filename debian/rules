%:
	dh $@

# There is nothing to compile, so install the two files by hand. Debian puts
# games in /usr/games with their manual pages in section 6, and /usr/games is
# on the default login PATH (see ENV_PATH in login.defs).
override_dh_auto_install:
	install -Dm755 maze.sh debian/maze/usr/games/maze
	install -Dm644 maze.1 debian/maze/usr/share/man/man6/maze.6
